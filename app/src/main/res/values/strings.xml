    <string name="onboarding_title_1">Welcome to Aether</string>
    <string name="onboarding_body_1">A fast, secure tunnel that beats censorship. One tap connects you through MASQUE, WireGuard or WARP×2.</string>
    <string name="onboarding_title_2">Smart protocol selection</string>
    <string name="onboarding_body_2">Smart mode analyzes your network and picks the protocol that actually works, with anti-DPI obfuscation when needed.</string>
    <string name="onboarding_title_3">Private by design</string>
    <string name="onboarding_body_3">No accounts, no logs, no trackers. Android will ask for VPN permission on your first connect; that is the system keeping you in control.</string>
